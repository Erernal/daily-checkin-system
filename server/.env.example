# ─────────────────────────────────────────────────────────────
#  防拖延强制打卡系统 · 后端环境变量示例
#  复制为 .env 后修改；用 Node 20.6+ 时可这样启动：
#    node --env-file=.env server.js
# ─────────────────────────────────────────────────────────────

# 服务端口（Nginx 反代时保持 3000，只在内网监听即可）
PORT=3000
HOST=0.0.0.0

# 生产环境务必改成随机长字符串！例如：openssl rand -hex 32
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# SQLite 数据库文件位置（目录不存在会自动创建）
DB_PATH=./data/checkin.db

# 业务时区与默认截止时间（用户可单独覆盖）
APP_TIMEZONE=Asia/Shanghai
DEFAULT_DEADLINE=22:00

# 首次启动时自动创建的管理员账号（已存在则忽略）
# 生产环境请务必设置强密码；留空会随机生成，并只在启动日志打印一次
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_before_deploy

# 前面的 Nginx 反代时打开，便于限流拿到真实 IP
TRUST_PROXY=true

# 需要限制跨域来源时填写，逗号分隔；留空表示允许所有（App 端通常没有 Origin）
# ALLOWED_ORIGINS=https://checkin.example.com
