{
  "expo": {
    "name": "拒绝摆烂（NoSlack）",
    "slug": "noslack",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "noslack",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.qiangzhi"
    },
    "android": {
      "package": "com.example.qiangzhi",
      "permissions": [
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "apiBase": "http://localhost:3000",
      "eas": {
        "projectId": "b3b51823-e9e5-47d9-a7c0-0cea8e79c710"
      }
    }
  }
}
